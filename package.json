{
  "name": "browser-markdown",
  "version": "0.2.0",
  "description": "Fast, safe in-place markdown rendering for Chrome & Firefox \u2014 GFM, KaTeX, Mermaid, TOC, themes, auto-reload.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@8.11.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "postinstall": "wxt prepare",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build -b chrome && wxt build -b firefox",
    "zip": "wxt zip -b chrome && wxt zip -b firefox",
    "e2e": "playwright test",
    "lint:firefox": "web-ext lint --source-dir output/firefox-mv3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/js-yaml": "^4.0.9",
    "@types/markdown-it": "^14.1.2",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "web-ext": "^10.5.0",
    "wxt": "^0.20.27"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@vscode/markdown-it-katex": "^1.1.2",
    "dompurify": "^3.4.12",
    "github-slugger": "^2.0.0",
    "highlight.js": "^11.11.1",
    "js-yaml": "^5.2.1",
    "katex": "^0.17.0",
    "markdown-it": "^14.3.0",
    "markdown-it-anchor": "^9.2.1",
    "markdown-it-deflist": "^3.0.1",
    "markdown-it-emoji": "^3.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^11.16.0"
  }
}
